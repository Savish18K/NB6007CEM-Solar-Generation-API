# Copy to .env for local development and fill in your own values. Don't commit .env.
# In production the same variables are set in the Vercel project (Settings -> Environment Variables).

NODE_ENV=development
PORT=3000

# Local: PGlite database stored on disk (no PostgreSQL install needed).
# Production (Vercel): the Neon *pooled* connection string (host contains "-pooler"), e.g.
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full
# Use sslmode=verify-full: Neon's certificate is publicly trusted, and pg prints a warning for sslmode=require.
# To seed Neon from your machine, put the same Neon string here and run: npm run db:seed
DATABASE_URL=pglite://./.data/pglite

# At least 32 characters. To generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=slsea-solar-api
JWT_AUDIENCE=slsea-solar-api
JWT_TTL_SECONDS=1800

# Back-office admin login (installation CRUD only)
ADMIN_CLIENT_ID=backoffice
ADMIN_CLIENT_SECRET=replace-with-a-long-random-secret

# The seeded meters' device secrets are derived from this, so keep it private and don't change it later
DEVICE_SECRET_SEED=replace-with-a-long-random-secret

# Password for the seeded demo analyst accounts
SEED_USER_PASSWORD=replace-with-a-demo-password

# Seed an empty database, then keep adding the synthetic 15-minute readings
# (local server: on a timer; Vercel: in the background after requests, at most every 5 minutes per instance)
SEED_ON_START=true
SEED_DAYS=8
